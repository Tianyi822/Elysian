# 开发用镜像：宿主机编辑源码，容器内跑 Bun + Vite（与容器内 sshd 联调环境）。
# API 不在此镜像：Go 后端由 apps/server-go/Dockerfile.go-dev 承载，其系统级夹具
# （ufw/iproute2、sudo、sqlite 专用 uid）仍复刻本镜像原有的服务器依赖。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip openssh-server \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://bun.sh/install | bash

# SSH 联调环境：预生成主机密钥，并建联调账号 elysian。
# -p '*' 表示不设可用密码但保持账号未锁定：shadow 里是 '!' 的锁定账号会被 sshd 拒绝公钥登录。
RUN ssh-keygen -A \
  && useradd -m -s /bin/bash -p '*' elysian \
  && cp /root/.bun/bin/bun /usr/local/bin/bun \
  && chmod 755 /usr/local/bin/bun

ENV BUN_INSTALL=/root/.bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

WORKDIR /app

# 48100 是面板 dev server（与契约 PANEL_PORT 同值）；22 是 compose command 里按需启动的 sshd（端口映射见 docker-compose.yml）。
EXPOSE 48100 22

CMD ["bun", "run", "dev"]
