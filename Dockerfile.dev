# 开发用镜像：宿主机编辑源码，容器内跑 Bun + Vite。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip ufw iproute2 openssh-server sudo \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://bun.sh/install | bash

# SSH 面板联调环境：预生成主机密钥，并建联调账号 elysian。
# -p '*' 表示不设可用密码但保持账号未锁定：shadow 里是 '!' 的锁定账号会被 sshd 拒绝公钥登录。
RUN ssh-keygen -A \
  && useradd -m -s /bin/bash -p '*' elysian \
  && groupadd -g 2001 elysian-sqlite \
  && useradd -u 2001 -g 2001 -M -s /usr/sbin/nologin elysian-sqlite \
  && cp /root/.bun/bin/bun /usr/local/bin/bun \
  && chmod 755 /usr/local/bin/bun

ENV BUN_INSTALL=/root/.bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

WORKDIR /app

# 48100 是面板 dev server（与契约 PANEL_PORT 同值）；22 是 compose command 里按需启动的 sshd（端口映射见 docker-compose.yml）。
EXPOSE 48100 22

CMD ["bun", "run", "dev"]
