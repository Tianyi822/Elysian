# 开发用镜像：宿主机编辑源码，容器内跑 Bun + Vite。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl unzip ufw iproute2 openssh-server sudo \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://bun.sh/install | bash

# SSH 面板联调环境：预生成主机密钥，并建联调账号 elysian。
# -p '*' 表示不设可用密码但保持账号未锁定：shadow 里是 '!' 的锁定账号会被 sshd 拒绝公钥登录。
RUN ssh-keygen -A \
  && useradd -m -s /bin/bash -p '*' elysian

ENV BUN_INSTALL=/root/.bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

WORKDIR /app

# 5173 是 dev server；22 是 compose command 里按需启动的 sshd（端口映射见 docker-compose.yml）。
EXPOSE 5173 22

CMD ["bun", "run", "dev"]
